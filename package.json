{
  "name": "encodium",
  "version": "1.6.0",
  "description": "Encodium — Standalone video encoding & library management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-check.js",
    "test:ffmpeg": "node tests/ffmpeg-check.js",
    "test:database": "node tests/database-check.js",
    "lint": "eslint . --ignore-pattern node_modules --ignore-pattern data",
    "security": "bash scripts/security-check.sh",
    "scan": "node cli.js scan",
    "clear": "node cli.js clear",
    "install-app": "bash install.sh"
  },
  "author": "HeartBtz",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "eslint": "^10.9.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
