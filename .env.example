# Encodium — Environment Configuration
#
# DB_PASS is REQUIRED (server will not start without it).
# JWT_SECRET is STRONGLY RECOMMENDED (random ephemeral secret used if not set;
#   all tokens are invalidated on every restart).
# NODE_ENV=production hides internal error details from API responses.

NODE_ENV=production

DB_HOST=localhost
DB_PORT=3306
DB_USER=encodium
DB_PASS=
DB_NAME=encodium

JWT_SECRET=

PORT=4000
MEDIA_DIR=/path/to/your/videos
ENCODE_DIR=./data/encoded
THUMB_DIR=./data/thumbs
MAX_WORKERS=2
