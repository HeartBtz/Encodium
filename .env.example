# Encodium — Environment Configuration
#
# DB_PASS is REQUIRED (server will not start without it).
# JWT_SECRET is REQUIRED in production and must contain at least 32 characters.
# NODE_ENV=production hides internal error details from API responses.

NODE_ENV=production

DB_HOST=localhost
DB_PORT=3306
DB_USER=encodium
DB_PASS=
DB_NAME=encodium

JWT_SECRET=

# Browser/API security
COOKIE_SECURE=false
# Empty means direct LAN access: forwarded headers are not trusted.
# Behind a proxy, list only its source IPs/CIDRs, never true or a hop count.
TRUST_PROXY=
# Exact permitted browser origins, if different from the request Host.
# With TLS termination and HTTP upstream, COOKIE_SECURE=true also accepts
# the HTTPS Origin matching Host. No HTTPS redirect is forced on LAN HTTP.
CORS_ORIGINS=
AUTH_RETURN_BEARER_TOKEN=false

PORT=4000

# Directories
# MEDIA_DIR is legacy — media sources are now managed via the web UI (Settings > Sources).
# If set, it will be auto-migrated as the first source on first boot.
MEDIA_DIR=
ENCODE_DIR=./data/encoded
THUMB_DIR=./data/thumbs
MAX_WORKERS=2
